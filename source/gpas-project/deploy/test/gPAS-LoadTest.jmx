        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; set domain for this loop" enabled="true">
          <stringProp name="BeanShellSampler.query">int num = ${__Random(1,${HOW_MANY_DOMAINS})};
vars.put(&quot;DOMAIN_NUM&quot;, &quot;&quot;+num);
if (num==1) {
	vars.put(&quot;CURRENT_DOMAIN&quot;, &quot;${DOMAIN}&quot;);
} else {
	vars.put(&quot;CURRENT_DOMAIN&quot;, &quot;${DOMAIN}_&quot; + num);
}

log.info(&quot;### THREAD:&quot;+${__threadNum}+&quot;, LOOP:&quot;+${LOOP_COUNT}+&quot;, DOMAIN:&quot;+vars.get(&quot;CURRENT_DOMAIN&quot;));</stringProp>
          <stringProp name="BeanShellSampler.filename"></stringProp>
          <stringProp name="BeanShellSampler.parameters"></stringProp>
          <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
        </BeanShellSampler>
        <hashTree/>
        <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="generate and send package" enabled="true"/>
        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; set parameter (getOrCreatePseudonymForList)" enabled="true">
            <stringProp name="BeanShellSampler.query">// max value-size ~64k bytes (entspricht ~1.200x UUIDs(36 bytes) + Tags(17 bytes))
Integer total = ${PACKAGE_SIZE};
Integer parts = 0;
StringJoiner VALUES = null;

do {
  VALUES = new StringJoiner(&quot;&lt;/values&gt;&lt;values&gt;&quot;);
  for (i=0; i&lt;1200 &amp;&amp; total&gt;0; i++,total--) VALUES.add(UUID.randomUUID().toString());
  vars.put(&quot;VALUES&quot;+(parts++), VALUES.toString());
} while (total&gt;0);

// count PSNs over all threads
props.put(&quot;PSN_COUNT&quot;, &quot;&quot; + (${__P(PSN_COUNT)} + ${PACKAGE_SIZE} ));
if (${HOW_MANY_DOMAINS}&gt;1) {
	props.put(&quot;PSN_COUNT_PER_DOMAIN&quot; + (${DOMAIN_NUM}&gt;1 ?&quot;_&quot;+${DOMAIN_NUM} :&quot;&quot;), &quot;&quot;+(Integer.parseInt(props.get(&quot;PSN_COUNT_PER_DOMAIN&quot;+(${DOMAIN_NUM}&gt;1 ?&quot;_&quot;+${DOMAIN_NUM} :&quot;&quot;))) + ${PACKAGE_SIZE} ));
}</stringProp>
