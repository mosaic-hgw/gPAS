                <stringProp name="script">if (&quot;${ABORT_ON_RESPONSE_ERROR}&quot;==&quot;true&quot; &amp;&amp; !&quot;200&quot;.equals(prev.getResponseCode())) {
	String out = &quot;### STOP TEST&quot;+(&quot;${THREADS}&quot;!=&quot;1&quot; ?&quot; (thread:${__threadNum})&quot; :&quot;&quot;)+&quot;: sql-error (create:&quot;+prev.getResponseCode()+&quot;)&quot;;
