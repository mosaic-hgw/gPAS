          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="(opt) write first stats-values per thread" enabled="true">
            <stringProp name="IfController.condition">${__groovy(${DB_STATS_LOGGING_EVERY_X_LOOPS}&gt;0)}</stringProp>
