            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="abort on response error (sql)" enabled="true">
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">if (&quot;${ABORT_ON_RESPONSE_ERROR}&quot;==&quot;true&quot; &amp;&amp; !&quot;200&quot;.equals(prev.getResponseCode())) {
	String out = &quot;### STOP TEST&quot;+(&quot;${THREADS}&quot;!=&quot;1&quot; ?&quot; (thread:${__threadNum})&quot; :&quot;&quot;)+&quot;: sql-error (last values:&quot;+prev.getResponseCode()+&quot;)&quot;;
	log.info(out);
	System.out.println(out);
	ctx.getEngine().stopTest();
}</stringProp>
            </BeanShellPostProcessor>
            <hashTree/>
