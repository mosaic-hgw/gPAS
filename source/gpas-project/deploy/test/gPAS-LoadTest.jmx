            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; get interesting variables" enabled="true">
              <stringProp name="BeanShellSampler.query">String[] keySet = {
	&quot;PSN_COUNT&quot;, &quot;RESULT_COUNT&quot;
};
String out = &quot;&quot;;
String starttime = vars.get(&quot;TEST_TIME&quot;);

String addKey(String key) {
	if ((vars.get(key)!=null || props.get(key)!=null) &amp;&amp; (&quot;${ABORT_ON_RESPONSE_ERROR}&quot;!=&quot;true&quot; || !key.contains(&quot;RESULT&quot;)))
		return &quot;(&apos;&quot;+starttime+&quot;&apos;,&apos;&quot;+key+&quot;&apos;,&quot;+(vars.get(key)==null ?props.get(key) :vars.get(key))+&quot;),&quot;;
	return &quot;&quot;;
}

for (key : keySet)
{
	out += addKey(key);
}
if (${HOW_MANY_DOMAINS}&gt;1) for (i=1; i&lt;=${HOW_MANY_DOMAINS}; i++)
{
	out += addKey(&quot;PSN_COUNT_PER_DOMAIN&quot; + (i&gt;1 ? &quot;_&quot;+i : &quot;&quot;));
	out += addKey(&quot;RESULT_COUNT_PER_DOMAIN&quot; + (i&gt;1 ? &quot;_&quot;+i : &quot;&quot;));
}

log.info(out.substring(0, out.length() -1));
vars.put(&quot;STAT_KEY_VALUE_PAIRS&quot;, out.substring(0, out.length() -1));</stringProp>
              <stringProp name="BeanShellSampler.filename"></stringProp>
              <stringProp name="BeanShellSampler.parameters"></stringProp>
