        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="log configuration before start" enabled="true">
          <stringProp name="BeanShellSampler.query">String out = 	&quot;#\n&quot; +
	&quot;# CONFIGURATION\n&quot; +
	&quot;# =============\n&quot; + 
	&quot;# GPAS_SOAP_PROTOCOL   = ${GPAS_SOAP_PROTOCOL}\n&quot; + 
	&quot;# GPAS_SOAP_HOST       = ${GPAS_SOAP_HOST}\n&quot; + 
	&quot;# GPAS_SOAP_PORT       = ${GPAS_SOAP_PORT}\n&quot; + 
	&quot;# GPAS_SOAP_CONTEXT       = ${GPAS_SOAP_CONTEXT}\n&quot; +
	&quot;# GPAS_SOAP_MANAGEMENT    = ${GPAS_SOAP_MANAGEMENT}\n&quot; +
	&quot;# GPAS_SOAP_SERVICE       = ${GPAS_SOAP_SERVICE}\n&quot; +
	&quot;#\n&quot; +
	&quot;# DOMAIN                  = ${DOMAIN}\n&quot; +
	&quot;# CHECK_DIGIT_CLASS       = ${CHECK_DIGIT_CLASS}\n&quot; +
	&quot;# ALPHABET                = ${ALPHABET}\n&quot; +
	&quot;# PROP_FORCE_CACHE        = ${PROP_FORCE_CACHE}\n&quot; +
	&quot;# PROP_PSN_LENGTH         = ${PROP_PSN_LENGTH}\n&quot; +
	&quot;# PROP_PREFIX             = ${PROP_PREFIX}\n&quot; +
	&quot;# COMMENT                 = ${COMMENT}\n&quot; +
	&quot;# PARENT_DOMAIN_NAME      = ${PARENT_DOMAIN_NAME}\n&quot; +
	&quot;#\n&quot; +
	&quot;# HOW_MANY_DOMAINS        = ${HOW_MANY_DOMAINS}\n&quot; +
	&quot;# THREADS                 = ${THREADS}\n&quot; +
	&quot;# RAMP_UP                 = ${RAMP_UP}\n&quot; +
	&quot;# LOOPS                   = ${LOOPS}\n&quot; +
	&quot;# PACKAGE_SIZE            = ${PACKAGE_SIZE}\n&quot; +
	&quot;# NEXT_REQUEST_TIME       = ${NEXT_REQUEST_TIME}\n&quot; +
	&quot;# ABORT_ON_RESPONSE_ERROR = ${ABORT_ON_RESPONSE_ERROR}\n&quot; +
	&quot;#\n&quot; +
	&quot;# RESTART_WILDFLY_EVERY_X_LOOPS  = ${RESTART_WILDFLY_EVERY_X_LOOPS} (enabled if grater than 0)\n&quot; +
	&quot;# RESTART_WILDFLY_ADMIN_USER     = ${RESTART_WILDFLY_ADMIN_USER}\n&quot; +
	&quot;# RESTART_WILDFLY_ADMIN_PASSWORD = ${RESTART_WILDFLY_ADMIN_PASSWORD}\n&quot; +
	&quot;#\n&quot; +
	&quot;# GET_PSNS_EVERY_X_LOOPS         = ${GET_PSNS_EVERY_X_LOOPS} (enabled if grater than 0)\n&quot; +
	&quot;# GET_PSNS_HOW_MANY              = ${GET_PSNS_HOW_MANY}\n&quot; +
	&quot;#\n&quot; +
	&quot;# DB_STATS_LOGGING_EVERY_X_LOOPS  = ${DB_STATS_LOGGING_EVERY_X_LOOPS} (enabled if grater than 0)\n&quot; +
	&quot;# DB_STATS_DB_HOST                = ${DB_STATS_DB_HOST}\n&quot; +
	&quot;# DB_STATS_DB_PORT                = ${DB_STATS_DB_PORT}\n&quot; +
	&quot;# DB_STATS_DB_NAME                = ${DB_STATS_DB_NAME}\n&quot; +
	&quot;# DB_STATS_DB_USER                = ${DB_STATS_DB_USER}\n&quot; +
	&quot;# DB_STATS_DB_PASSWORD            = ${DB_STATS_DB_PASSWORD}\n&quot; +
	&quot;#&quot;;
System.out.println(out);
log.info(&quot;\n&quot;+out);</stringProp>
          <stringProp name="BeanShellSampler.filename"></stringProp>
          <stringProp name="BeanShellSampler.parameters"></stringProp>
