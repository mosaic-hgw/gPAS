        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; set individual variables" enabled="false">
            <stringProp name="BeanShellSampler.query">// CONNECTION /////////////////////////////////////////////////////////////////////////////////////////
//vars.put(&quot;GPAS_SOAP_PROTOCOL&quot;,              &quot;http&quot;);
vars.put(&quot;GPAS_SOAP_HOST&quot;,                  &quot;192.168.56.101&quot;);
//vars.put(&quot;GPAS_SOAP_PORT&quot;,                  &quot;8080&quot;);
//vars.put(&quot;GPAS_SOAP_CONTEXT&quot;,               &quot;&quot;);
//vars.put(&quot;GPAS_SOAP_MANAGEMENT&quot;,            &quot;&quot;);
//vars.put(&quot;GPAS_SOAP_SERVICE&quot;,               &quot;&quot;);

// DOMAIN-CONFIGURATION ///////////////////////////////////////////////////////////////////////////////
//vars.put(&quot;DOMAIN&quot;,                          &quot;dummy&quot;);
//vars.put(&quot;CHECK_DIGIT_CLASS&quot;,               &quot;org.emau.icmvc.ganimed.ttp.psn.generator.Verhoeff&quot;);
//vars.put(&quot;ALPHABET&quot;,                        &quot;org.emau.icmvc.ganimed.ttp.psn.alphabets.Numbers&quot;);
vars.put(&quot;PROP_FORCE_CACHE&quot;,                &quot;OFF&quot;);
vars.put(&quot;PROP_PSN_LENGTH&quot;,                 &quot;11&quot;);
//vars.put(&quot;PROP_PREFIX&quot;,                     &quot;dmy_&quot;);
//vars.put(&quot;COMMENT&quot;,                         &quot;&quot;);
//vars.put(&quot;PARENT_DOMAIN_NAME&quot;,              &quot;&quot;);

// TEST-CONFIGURATION /////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;HOW_MANY_DOMAINS&quot;,                &quot;5&quot;);
vars.put(&quot;PACKAGE_SIZE&quot;,                    &quot;2000&quot;);
//vars.put(&quot;NEXT_REQUEST_TIME&quot;,               &quot;0&quot;);
vars.put(&quot;ABORT_ON_RESPONSE_ERROR&quot;,         &quot;true&quot;);

// RESTART-CONFIGURATION //////////////////////////////////////////////////////////////////////////////
vars.put(&quot;RESTART_WILDFLY_EVERY_X_LOOPS&quot;,   &quot;0&quot;);
//vars.put(&quot;RESTART_WILDFLY_ADMIN_USER&quot;,      &quot;admin&quot;);
//vars.put(&quot;RESTART_WILDFLY_ADMIN_PASSWORD&quot;,  &quot;wildfly_password&quot;);

// GET-PSNs-TEST //////////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;GET_PSNS_EVERY_X_LOOPS&quot;,          &quot;5&quot;);
vars.put(&quot;GET_PSNS_HOW_MANY&quot;,               &quot;2000&quot;);

// DB-STATS-LOGGING ///////////////////////////////////////////////////////////////////////////////////
vars.put(&quot;DB_STATS_LOGGING_EVERY_X_LOOPS&quot;,  &quot;0&quot;);
vars.put(&quot;DB_STATS_DB_HOST&quot;,                &quot;dockervm&quot;);
//vars.put(&quot;DB_STATS_DB_PORT&quot;,                &quot;3306&quot;);
//vars.put(&quot;DB_STATS_DB_NAME&quot;,                &quot;gpas&quot;);
vars.put(&quot;DB_STATS_DB_USER&quot;,                &quot;root&quot;);
vars.put(&quot;DB_STATS_DB_PASSWORD&quot;,            &quot;root&quot;);
</stringProp>
            <stringProp name="BeanShellSampler.filename"></stringProp>
            <stringProp name="BeanShellSampler.parameters"></stringProp>
            <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
          </BeanShellSampler>
