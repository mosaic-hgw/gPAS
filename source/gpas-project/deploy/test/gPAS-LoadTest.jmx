        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="(opt) stats-logging" enabled="true">
          <stringProp name="TestPlan.comments">optional</stringProp>
          <stringProp name="IfController.condition">${__groovy(${DB_STATS_LOGGING_EVERY_X_LOOPS}&gt;0 &amp;&amp; ${LOOP_COUNT} % ${DB_STATS_LOGGING_EVERY_X_LOOPS}==0)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; get interesting variables" enabled="true">
            <stringProp name="BeanShellSampler.query">String[] keySet = {
	&quot;LOOP_COUNT&quot;,
	&quot;PSN_COUNT&quot;,
	&quot;PSN_COUNT_PER_DOMAIN${__groovy(${DOMAIN_NUM}&gt;1 ? &apos;_${DOMAIN_NUM}&apos; : &apos;&apos;)}&quot;,
	&quot;RESULT_COUNT&quot;,
	&quot;RESULT_COUNT_PER_DOMAIN${__groovy(${DOMAIN_NUM}&gt;1 ? &apos;_${DOMAIN_NUM}&apos; : &apos;&apos;)}&quot;,
	&quot;WILDFLY_RESTART_TIME&quot;,
	&quot;GPAS_GETVALUEFORLIST_TIME&quot;
};
String out = &quot;&quot;;
String starttime = vars.get(&quot;TEST_TIME&quot;);

for (key : keySet)
{
	if (vars.get(key)!=null || props.get(key)!=null)
	{
		if (${HOW_MANY_DOMAINS} == 1 &amp;&amp; key.contains(&quot;PER_DOMAIN&quot;)) continue;
		if (&quot;${ABORT_ON_RESPONSE_ERROR}&quot;==&quot;true&quot; &amp;&amp; (key.contains(&quot;RESULT&quot;))) continue;
		out += &quot;(&apos;&quot;+starttime+&quot;&apos;,&apos;&quot; + (key==&quot;LOOP_COUNT&quot; ?&quot;LOOP_COUNT_PER_THREAD&quot;+(${__threadNum}&gt;1 ?&quot;_&quot;+${__threadNum} :&quot;&quot;) :key) + &quot;&apos;,&apos;&quot; + (vars.get(key)==null ? props.get(key) : vars.get(key))+ &quot;&apos;),&quot;;
	}
}

// clearing
vars.remove(&quot;WILDFLY_RESTART_TIME&quot;);
vars.remove(&quot;GPAS_GETVALUEFORLIST_TIME&quot;);

// all variables
//for (entry : vars.entrySet()) out += &quot;(&apos;&quot; + entry.getKey() + &quot;&apos;,&apos;&quot; + entry.getValue() + &quot;&apos;),&quot;;

//log.info(out.substring(0, out.length() -1));
vars.put(&quot;STAT_KEY_VALUE_PAIRS&quot;, out.substring(0, out.length() -1));</stringProp>
            <stringProp name="BeanShellSampler.filename"></stringProp>
            <stringProp name="BeanShellSampler.parameters"></stringProp>
            <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
          </BeanShellSampler>
          <hashTree/>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="write stats-values" enabled="true">
            <stringProp name="dataSource">_CONN_STATS</stringProp>
            <stringProp name="queryType">Update Statement</stringProp>
            <stringProp name="query">INSERT IGNORE INTO `jmeter_stats` (`starttime`,`key`,`value`) VALUES ${STAT_KEY_VALUE_PAIRS};
</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
