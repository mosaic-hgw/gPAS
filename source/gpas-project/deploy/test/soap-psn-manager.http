### Get Value
POST {{soap_service_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:getValueFor>
			<psn>{{psn_1}}</psn>
			<domainName>{{domain_name}}</domainName>
		</psn:getValueFor>
	</soapenv:Body>
</soapenv:Envelope>


### Get Value for List
POST {{soap_service_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:getValueForList>
			<!--1 or more repetitions:-->
			<psnList>{{psn_1}}</psnList>
			<psnList>{{psn_2}}</psnList>
			<domainName>{{domain_name}}</domainName>
		</psn:getValueForList>
	</soapenv:Body>
</soapenv:Envelope>


### Insert Value Pseudonym Pair
POST {{soap_service_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:insertValuePseudonymPair>
			<value>{{value_1}}</value>
			<pseudonym>{{psn_1}}</pseudonym>
			<domainName>{{domain_name}}</domainName>
		</psn:insertValuePseudonymPair>
	</soapenv:Body>
</soapenv:Envelope>


### Insert Value Pseudonym Pairs
POST {{soap_service_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:insertValuePseudonymPairs>
			<pairs>
				<!--Zero or more repetitions:-->
				<entry>
					<!--Optional:-->
					<key>{{value_1}}</key>
					<!--Optional:-->
					<value>{{psn_1}}</value>
				</entry>
				<entry>
					<!--Optional:-->
					<key>{{value_2}}</key>
					<!--Optional:-->
					<value>{{psn_2}}</value>
				</entry>
			</pairs>
			<domainName>{{domain_name}}</domainName>
		</psn:insertValuePseudonymPairs>
	</soapenv:Body>
</soapenv:Envelope>


