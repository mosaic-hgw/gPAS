# https://www.jetbrains.com/help/idea/http-client-in-product-code-editor.html
# https://www.jetbrains.com/help/idea/exploring-http-syntax.html#environment-variables

@soap_service_url = {{protocol}}://{{host}}:{{port}}/{{soap_context}}/{{soap_service}}
@value_prefix = value_prefix
@value_1 = {{$random.alphabetic(8)}}
@value_2 = {{$random.alphabetic(8)}}
@psn_1 = test_psn_1
@psn_2 = test_psn_2


### Anonymise All Entries for Value
POST {{soap_service_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:anonymiseAllEntriesForValue>
			<value>{{value_1}}</value>
			<domainName>{{domain_name}}</domainName>
		</psn:anonymiseAllEntriesForValue>
	</soapenv:Body>
</soapenv:Envelope>


### Anonymise All Entries for Values
POST {{soap_service_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:anonymiseAllEntriesForValues>
			<!--1 or more repetitions:-->
			<values>{{value_1}}</values>
			<values>{{value_2}}</values>
			<domainName>{{domain_name}}</domainName>
		</psn:anonymiseAllEntriesForValues>
	</soapenv:Body>
</soapenv:Envelope>


