                    <stringProp name="BeanShellAssertion.query">import java.util.ArrayList;
import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathFactory;
import org.apache.commons.lang3.ArrayUtils;
import org.w3c.dom.Document;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

ArrayList elem = new ArrayList();
elem.add(&quot;anonymiseEntries&quot;);
elem.add(&quot;anonymiseEntry&quot;);
elem.add(&quot;deleteEntries&quot;);
elem.add(&quot;deleteEntry&quot;);
elem.add(&quot;getOrCreatePseudonymFor&quot;);
elem.add(&quot;getOrCreatePseudonymForList&quot;);
elem.add(&quot;getPSNNetFor&quot;);
elem.add(&quot;getPSNTreeForPSN&quot;);
elem.add(&quot;getPseudonymFor&quot;);
elem.add(&quot;getPseudonymForList&quot;);
elem.add(&quot;getPseudonymForValuePrefix&quot;);
elem.add(&quot;getValueFor&quot;);
elem.add(&quot;getValueForList&quot;);
elem.add(&quot;insertValuePseudonymPair&quot;);
elem.add(&quot;insertValuePseudonymPairs&quot;);
elem.add(&quot;isAnonym&quot;);
elem.add(&quot;isAnonymised&quot;);
elem.add(&quot;validatePSN&quot;);


// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
}

if (Failure != true) try {
	NodeList nodes = (NodeList) XPathFactory.newInstance().newXPath().compile(&quot;/definitions/types/schema/element&quot;).evaluate(doc, XPathConstants.NODESET);
	ArrayList names = new ArrayList();
	ArrayList notFound = new ArrayList();
	// ignore Exceptions and Response
	for (i = 0; i &lt; nodes.getLength(); i++) {
		//log.info(&quot;&quot; + nodeList.item(i).getAttribute(&quot;name&quot;));
		if (
			!nodes.item(i).getAttribute(&quot;name&quot;).endsWith(&quot;Exception&quot;) &amp;&amp; !nodes.item(i).getAttribute(&quot;name&quot;).endsWith(&quot;Response&quot;) &amp;&amp;
			!nodes.item(i).getAttribute(&quot;name&quot;).endsWith(&quot;DTO&quot;) &amp;&amp; !nodes.item(i).getAttribute(&quot;name&quot;).equals(&quot;psndto&quot;)
		) names.add(nodes.item(i).getAttribute(&quot;name&quot;));
	}
	ArrayList newList = names.clone();
	//log.info(&quot;names = &quot; + names.size());
	//log.info(&quot;elem = &quot; + elem.size());
	for (i = 0; i &lt; names.size(); i++) {
		if (elem.contains(names.get(i))) {
			elem.remove(names.get(i));
			//log.info(&quot;found:&quot; + names.get(i) + &quot; count:&quot; + elem.size());
		} else {
			notFound.add(names.get(i));
			//log.info(&quot;not found:&quot; + names.get(i) + &quot; count:&quot; + notFound.size());	
		}
	}
	if (notFound.size() &gt; 0 || elem.size() &gt; 0) {
		Failure = true ;
		FailureMessage = &quot;divergent elements found!&quot;;
		if (notFound.size() &gt; 0) {
			FailureMessage += &quot;\n\nnew elements:\n - &quot; + String.join(&quot;\n - &quot;, notFound);
		}
		if (elem.size() &gt; 0) {
			FailureMessage += &quot;\n\nremoved elements:\n - &quot; + String.join(&quot;\n - &quot;, elem);
		}
		if (notFound.size() &gt; 0 || elem.size() &gt; 0) {
			FailureMessage += &quot;\n\nnew list:\nelem.add(\&quot;&quot; + String.join(&quot;\&quot;);\nelem.add(\&quot;&quot;, newList) + &quot;\&quot;);&quot;;
		}
	}
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot read result because: &quot; + e.printStackTrace();
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
} else {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;false&quot;);
}

