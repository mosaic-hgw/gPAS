                  <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="get RESULT" enabled="true">
                    <stringProp name="BeanShellAssertion.query">import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathFactory;
import org.w3c.dom.Document;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
}

if (Failure != true) try {
	String expression = &quot;/Envelope/Body/getDomainResponse/domain&quot;;
	NodeList domains = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
	if (domains.getLength() == 1) {
		vars.put(&quot;RESULT_DOMAIN_NAME&quot;,		domains.item(0).getElementsByTagName(&quot;name&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CHECK_DIGIT_CLASS&quot;,	domains.item(0).getElementsByTagName(&quot;checkDigitClass&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_ALPHABET&quot;,			domains.item(0).getElementsByTagName(&quot;alphabet&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_COMMENT&quot;,			domains.item(0).getElementsByTagName(&quot;comment&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_NUMBER_OF_PSNS&quot;,		domains.item(0).getElementsByTagName(&quot;numberOfPseudonyms&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CACHE_USED&quot;,			domains.item(0).getElementsByTagName(&quot;cacheUsed&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_PERCENT_PSNS_USED&quot;,	domains.item(0).getElementsByTagName(&quot;percentPsnsUsed&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_FORCE_CACHE&quot;,							domains.item(0).getElementsByTagName(&quot;forceCache&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_INCLUDE_PREFIX_IN_CHECK_DIGIT_CALCULATION&quot;,	domains.item(0).getElementsByTagName(&quot;includePrefixInCheckDigitCalculation&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_INCLUDE_SUFFIX_IN_CHECK_DIGIT_CALCULATION&quot;,	domains.item(0).getElementsByTagName(&quot;includeSuffixInCheckDigitCalculation&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_MAX_DETECTED_ERRORS&quot;,					domains.item(0).getElementsByTagName(&quot;maxDetectedErrors&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSN_LENGTH&quot;,							domains.item(0).getElementsByTagName(&quot;psnLength&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSN_PREFIX&quot;,							domains.item(0).getElementsByTagName(&quot;psnPrefix&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSN_SUFFIX&quot;,							domains.item(0).getElementsByTagName(&quot;psnSuffix&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSNS_DELETABLE&quot;,						domains.item(0).getElementsByTagName(&quot;psnsDeletable&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_USE_LAST_CHAR_AS_DELIMITER_AFTER_X_CHARS&quot;,	domains.item(0).getElementsByTagName(&quot;useLastCharAsDelimiterAfterXChars&quot;).item(0).getTextContent());
	}
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot read domains because: &quot; + e.printStackTrace();
}

if (Failure) {
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
                    <stringProp name="BeanShellAssertion.filename"></stringProp>
