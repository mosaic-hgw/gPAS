          <GenericController guiclass="LogicControllerGui" testclass="GenericController" testname="PSN - list-functions" enabled="true"/>
          <hashTree>
            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="--------- start PSN-Test list-functions ---------" enabled="true">
              <stringProp name="BeanShellSampler.query">log.info(Label);
System.out.println(&quot;jmeter &quot; + Label);</stringProp>
            </BeanShellSampler>
            <hashTree/>
            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; set parameter" enabled="true">
              <stringProp name="BeanShellSampler.query">// global
vars.put(&quot;RND&quot;, &quot;L${__RandomString(5,ABCDEFGHIJKLMNOPQRSTUVWXYZ)}&quot;);
String RND = vars.get(&quot;RND&quot;);
vars.put(&quot;MAX_PSNS&quot;, &quot;50&quot;);	// 21 or more

// addDomain
vars.put(&quot;DOMAIN&quot;,			&quot;test_&quot;+RND);
vars.put(&quot;CHECK_DIGIT_CLASS&quot;,	&quot;org.emau.icmvc.ganimed.ttp.psn.generator.Verhoeff&quot;);
vars.put(&quot;ALPHABET&quot;,		&quot;org.emau.icmvc.ganimed.ttp.psn.alphabets.Numbers&quot;);
vars.put(&quot;FORCE_CACHE&quot;,		&quot;ON&quot;);	// DEFAULT, ON, OFF
vars.put(&quot;PSN_LENGTH&quot;,		&quot;6&quot;);
vars.put(&quot;CHECK_DIGIT_LENGTH&quot;,&quot;1&quot;);
vars.put(&quot;PREFIX&quot;,			RND+&quot;_&quot;);
vars.put(&quot;SUFFIX&quot;,			&quot;&quot;);
vars.put(&quot;COMMENT&quot;,			RND+&quot;_functionstest&quot;);
vars.put(&quot;PSNS_DELETABLE&quot;,	&quot;false&quot;);
vars.put(&quot;PREFIX_IN_CHECK&quot;,	&quot;false&quot;);
vars.put(&quot;SUFFIX_IN_CHECK&quot;,	&quot;false&quot;);
vars.put(&quot;MAX_DETECTED_ERR&quot;,	&quot;2&quot;);
vars.put(&quot;LAST_X_CHAR&quot;,		&quot;0&quot;);

// add values
vars.put(&quot;TEST_VALUE_1&quot;,		RND+&quot;_value_1_${__RandomString(10,0123456789)}&quot;);
vars.put(&quot;TEST_PREFIX_1&quot;,	RND+&quot;_value_1&quot;);

vars.put(&quot;TEST_VALUE_2&quot;,		RND+&quot;_value_2&quot;);
vars.put(&quot;TEST_PSN_2_LENGTH&quot;,	RND+&quot;_12345678&quot;);	// sollte fehlschlagen, falsche Länge
vars.put(&quot;TEST_PSN_2_CHAR&quot;,	RND+&quot;_a123456&quot;);	// sollte fehlschlagen, fasches Zeichen
vars.put(&quot;TEST_PSN_2_DIGIT&quot;,	RND+&quot;_123456a&quot;);	// sollte fehlschlagen, fasche Prüfziffer
vars.put(&quot;TEST_PSN_2&quot;,		RND+&quot;_1234567&quot;);	// sollte klappen, 6 (PSN-Länge) + 1 (Prüfziffer)

