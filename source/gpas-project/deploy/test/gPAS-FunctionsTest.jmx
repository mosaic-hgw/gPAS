vars.put(&quot;PSN_LENGTH&quot;,		&quot;6&quot;);
vars.put(&quot;PREFIX&quot;,			RND+&quot;_&quot;);
vars.put(&quot;SUFFIX&quot;,			&quot;&quot;);
vars.put(&quot;COMMENT&quot;,			RND+&quot;_functionstest&quot;);
vars.put(&quot;PSNS_DELETABLE&quot;,	&quot;false&quot;);
vars.put(&quot;PREFIX_IN_CHECK&quot;,	&quot;false&quot;);
vars.put(&quot;SUFFIX_IN_CHECK&quot;,	&quot;false&quot;);
