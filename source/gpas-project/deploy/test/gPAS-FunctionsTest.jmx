			entryFound++;
			continue;
		}
	}
	if (isEqual(&quot;RESULT_VALUE_&quot; + i, &quot;TEST_VALUE_1&quot;) &amp;&amp; isEqual(&quot;RESULT_PSN_&quot; + i, &quot;TEST_PSN_1&quot;)) entryFound++;
