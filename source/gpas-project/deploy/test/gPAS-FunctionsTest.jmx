                  <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="test CONTAINS" enabled="true">
                    <stringProp name="BeanShellAssertion.query">boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}

if (isSet(&quot;TEST_CONTAINS&quot;) &amp;&amp; !vars.get(&quot;DATA_RESPONSE_BODY&quot;).contains(vars.get(&quot;TEST_CONTAINS&quot;))) {
	Failure = true ;
	FailureMessage = &quot;text expected to contain: &quot; + vars.get(&quot;TEST_CONTAINS&quot;);
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
