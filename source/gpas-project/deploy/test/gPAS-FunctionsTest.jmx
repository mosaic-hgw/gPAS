                    <stringProp name="script">String responseBody = new String(data);
vars.put(&quot;DATA_RESPONSE_BODY&quot;, responseBody);

if (vars.get(&quot;DEBUG_LOGGING&quot;).equalsIgnoreCase(&quot;true&quot;)) {
