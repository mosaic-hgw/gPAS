        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; set parameter MULTIPSN=true">
          <stringProp name="BeanShellSampler.query">vars.put(&quot;OPT_PROP_MULTIPSN&quot;,		&quot;true&quot;);

// reset artifacts from previous tests
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
for (i = 0; isSet(&quot;PARAM_VALUE_&quot; + i); i++) vars.remove(&quot;PARAM_VALUE_&quot; + i);
for (i = 0; isSet(&quot;RESULT_SUCCESS_&quot; + i); i++) vars.remove(&quot;RESULT_SUCCESS_&quot; + i);
for (i = 0; isSet(&quot;TEST_UUID_VALUE_&quot; + i); i++) vars.remove(&quot;TEST_UUID_VALUE_&quot; + i);
</stringProp>
        </BeanShellSampler>
