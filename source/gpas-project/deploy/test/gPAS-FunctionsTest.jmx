            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; set parameter">
              <stringProp name="BeanShellSampler.query">// global
vars.put(&quot;RND&quot;, &quot;S${__RandomString(5,ABCDEFGHIJKLMNOPQRSTUVWXYZ)}&quot;);
String RND = vars.get(&quot;RND&quot;);

// addDomain
vars.put(&quot;DOMAIN&quot;,			&quot;test_&quot;+RND);
vars.put(&quot;CHECK_DIGIT_CLASS&quot;,	&quot;org.emau.icmvc.ganimed.ttp.psn.generator.Verhoeff&quot;);
vars.put(&quot;ALPHABET&quot;,		&quot;org.emau.icmvc.ganimed.ttp.psn.alphabets.Numbers&quot;);
vars.put(&quot;FORCE_CACHE&quot;,		&quot;ON&quot;);	// DEFAULT, ON, OFF
vars.put(&quot;PSN_LENGTH&quot;,		&quot;6&quot;);
vars.put(&quot;CHECK_DIGIT_LENGTH&quot;,&quot;1&quot;);
vars.put(&quot;PREFIX&quot;,			RND+&quot;_&quot;);
vars.put(&quot;SUFFIX&quot;,			&quot;&quot;);
vars.put(&quot;COMMENT&quot;,			RND+&quot;_functionstest&quot;);
vars.put(&quot;PSNS_DELETABLE&quot;,	&quot;false&quot;);
vars.put(&quot;PREFIX_IN_CHECK&quot;,	&quot;false&quot;);
vars.put(&quot;SUFFIX_IN_CHECK&quot;,	&quot;false&quot;);
vars.put(&quot;MAX_DETECTED_ERR&quot;,	&quot;2&quot;);
vars.put(&quot;LAST_X_CHAR&quot;,		&quot;0&quot;);

// add values
vars.put(&quot;TEST_VALUE_1&quot;,		RND+&quot;_value_1&quot;);

vars.put(&quot;TEST_VALUE_2&quot;,		RND+&quot;_value_2&quot;);
vars.put(&quot;TEST_PSN_2_PREFIX&quot;,	&quot;blub_&quot; + &quot;12345678&quot;);			// sollte fehlschlagen, falsches Prefix
vars.put(&quot;TEST_PSN_2_LENGTH&quot;,	vars.get(&quot;PREFIX&quot;) + &quot;12345678&quot;);	// sollte fehlschlagen, falsche Länge
vars.put(&quot;TEST_PSN_2_CHAR&quot;,	vars.get(&quot;PREFIX&quot;) + &quot;x123456&quot;);	// sollte fehlschlagen, fasches Zeichen
vars.put(&quot;TEST_PSN_2_DIGIT&quot;,	vars.get(&quot;PREFIX&quot;) + &quot;1234560&quot;);	// sollte fehlschlagen, fasche Prüfziffer
vars.put(&quot;TEST_PSN_2&quot;,		vars.get(&quot;PREFIX&quot;) + &quot;1234567&quot;);	// sollte klappen, 6 (PSN-Länge) + 1 (Prüfziffer)

vars.put(&quot;TEST_VALUE_3&quot;,		RND+&quot;_value_3&quot;);</stringProp>
            </BeanShellSampler>
