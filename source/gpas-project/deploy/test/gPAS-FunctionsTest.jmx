              <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; set parameter (countPSNs, page-size 1)" enabled="true">
                <stringProp name="BeanShellSampler.query">String out = Label.replace(&quot;&gt;&gt; set parameter (&quot;, &quot;jmeter --------- &quot;).replace(&quot;)&quot;, &quot; ---------&quot;);
log.info(out);
System.out.println(out);

// clear params
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
for (i = 0; isSet(&quot;OPT_KEY_&quot; + i) || isSet(&quot;OPT_VALUE_&quot; + i); i++) {
	vars.remove(&quot;OPT_KEY_&quot; + i);
	vars.remove(&quot;OPT_VALUE_&quot; + i);
}

// requierd
vars.put(&quot;PARAM_DOMAIN&quot;,			&quot;${DOMAIN}&quot;);
vars.put(&quot;PARAM_FILTER_FIELDS_ARE_TREATED_AS_CONJUNCTION&quot;,		&quot;&quot;);
vars.put(&quot;PARAM_FILTER_CASESENSITIVE&quot;,		&quot;&quot;);
vars.put(&quot;PARAM_FIRST_ENTRY&quot;,		&quot;1&quot;);
vars.put(&quot;PARAM_PAGE_SIZE&quot;,		&quot;1&quot;);
vars.put(&quot;PARAM_SORT_ASC&quot;,		&quot;&quot;);
// optional
vars.put(&quot;OPT_SORT_FIELD&quot;,		&quot;&quot;);
vars.put(&quot;OPT_KEY_0&quot;,			&quot;&quot;);	// 0,1,2..n 
vars.put(&quot;OPT_VALUE_0&quot;,			&quot;&quot;);	// 0,1,2..n
// test
vars.put(&quot;TEST_STATUS_CODE&quot;,		&quot;200&quot;);
vars.put(&quot;TEST_CONTAINS&quot;,		&quot;&quot;);
vars.put(&quot;TEST_COUNT&quot;,			&quot;2&quot;);

// logging
vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;,	&quot;false&quot;);</stringProp>
              </BeanShellSampler>
