                  <stringProp name="BeanShellAssertion.query">boolean havePsn = false;
boolean equalPrefix = true;
boolean equalSuffix = true;
boolean equalLength = true;
boolean equalDomain = true;
boolean isEqual(String v1, String v2) {return new String(vars.get(v1)).equals(vars.get(v2));}
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
i = 0;

for (; isSet(&quot;RESULT_PSN_&quot; + i); i++) {
	havePsn = true;
	if (vars.get(&quot;RESULT_PSN_&quot; + i).startsWith(vars.get(&quot;PREFIX&quot;)) == false) {
		equalPrefix = false;
		break;
	}
	if (vars.get(&quot;RESULT_PSN_&quot; + i).endsWith(vars.get(&quot;SUFFIX&quot;)) == false) {
		equalSuffix = false;
		break;
	}
	if (vars.get(&quot;RESULT_PSN_&quot; + i).replace(vars.get(&quot;PREFIX&quot;),&quot;&quot;).replace(vars.get(&quot;SUFFIX&quot;),&quot;&quot;).length() != ${__intSum(${PSN_LENGTH},${CHECK_DIGIT_LENGTH})}) {
		equalLength = false;
		break;
	}
	if (isEqual(&quot;RESULT_DOMAIN_&quot; + i, &quot;PARAM_DOMAIN&quot;) == false) {
		equalDomain = false;
		break; 
	}
}

if (havePsn == false) {
	Failure = true ;
	FailureMessage = &quot;psns not found&quot;;
} else if (equalPrefix == false) {
	Failure = true ;
	FailureMessage = &quot;psn-prefix ${PREFIX} not in &quot; + vars.get(&quot;RESULT_PSN_&quot; + i);
} else if (equalSuffix == false) {
	Failure = true ;
	FailureMessage = &quot;psn-suffix ${SUFFIX} not in &quot; + vars.get(&quot;RESULT_PSN_&quot; + i);
} else if (equalLength == false) {
	Failure = true ;
	FailureMessage = &quot;psn-length (${PSN_LENGTH}) + check-digit (${CHECK_DIGIT_LENGTH}) not correct for \&quot;&quot; + vars.get(&quot;RESULT_VALUE_&quot; + i) + &quot;\&quot; with length &quot; + vars.get(&quot;RESULT_VALUE_&quot; + i).replace(&quot;${PREFIX}&quot;,&quot;&quot;).replace(&quot;${SUFFIX}&quot;,&quot;&quot;).length();
} else if (equalDomain == false) {
	Failure = true ;
	FailureMessage = &quot;wrong domain at &quot; + vars.get(&quot;RESULT_PSN_&quot; + i) + &quot;, expected ${PARAM_DOMAIN}, found &quot; + vars.get(&quot;RESULT_DOMAIN_&quot; + i);
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}
</stringProp>
