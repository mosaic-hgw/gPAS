}

if (expectedFound != entryFound) {
	Failure = true ;
	FailureMessage = &quot;psns not found &quot; + entryFound + &quot;/&quot; + expectedFound;
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
