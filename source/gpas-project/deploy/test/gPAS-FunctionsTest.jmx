              <hashTree>
                <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="test RESULT">
                  <stringProp name="BeanShellAssertion.query">boolean havePsn = false;
boolean equalPrefix = false;
boolean equalSuffix = false;
boolean equalLength = false;
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}

if (isSet(&quot;RESULT_PSN&quot;)) {
	havePsn = true;
	if (vars.get(&quot;RESULT_PSN&quot;).startsWith(vars.get(&quot;PREFIX&quot;))) equalPrefix = true;
	if (vars.get(&quot;RESULT_PSN&quot;).endsWith(vars.get(&quot;SUFFIX&quot;))) equalSuffix = true;
	if (vars.get(&quot;RESULT_PSN&quot;).replace(vars.get(&quot;PREFIX&quot;),&quot;&quot;).replace(vars.get(&quot;SUFFIX&quot;),&quot;&quot;).length() == ${__intSum(${PSN_LENGTH},${CHECK_DIGIT_LENGTH})}) equalLength = true;
}

if (havePsn == false) {
	Failure = true ;
	FailureMessage = &quot;psn not found&quot;;
} else if (equalPrefix == false) {
	Failure = true ;
	FailureMessage = &quot;psn-prefix ${PREFIX} not in ${RESULT_PSN}&quot;;
} else if (equalSuffix == false) {
	Failure = true ;
	FailureMessage = &quot;psn-suffix ${SUFFIX} not in ${RESULT_PSN}&quot;;
} else if (equalLength == false) {
	Failure = true ;
	FailureMessage = &quot;psn-length + check-digit + ${PSN_LENGTH} + ${CHECK_DIGIT_LENGTH} not correct for ${RESULT_PSN} with length &quot; + vars.get(&quot;RESULT_PSN&quot;).replace(&quot;${PREFIX}&quot;,&quot;&quot;).replace(&quot;${SUFFIX}&quot;,&quot;&quot;).length();
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
                  <stringProp name="BeanShellAssertion.filename"></stringProp>
                  <stringProp name="BeanShellAssertion.parameters"></stringProp>
                  <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
                </BeanShellAssertion>
                <hashTree/>
                <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="log by error" enabled="true">
                  <stringProp name="BeanShellAssertion.query">if (vars.get(&quot;LOG_REQUEST_AND_RESPONSE&quot;).equalsIgnoreCase(&quot;true&quot;)) {
	String out = &quot;\n&quot;+
	             &quot;REQUEST &gt;&gt;&gt;\n&quot;+
	             vars.get(&quot;DATA_REQUEST_BODY&quot;)+&quot;\n&quot;+
	             &quot;\n&quot;+
	             &quot;RESPONSE &gt;&gt;&gt;\n&quot;+
	             vars.get(&quot;DATA_RESPONSE_BODY&quot;)+&quot;\n&quot;;
	
	log.info(out);
	System.out.println(out);
}
</stringProp>
