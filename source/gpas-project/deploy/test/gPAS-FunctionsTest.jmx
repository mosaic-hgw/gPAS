                  <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="get RESULT">
                    <stringProp name="BeanShellAssertion.query">import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathFactory;
import org.w3c.dom.Document;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

String getValue(Node node, String value) {return (node.getElementsByTagName(value).length&gt;0 ?node.getElementsByTagName(value).item(0).getTextContent() :&quot;&quot;);}

// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
}

if (Failure != true) try {
	String expression = &quot;/Envelope/Body/listDomainsResponse/return/domainList&quot;;
	NodeList domains = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
	vars.put(&quot;RESULT_COUNT&quot;,	&quot;&quot;+domains.getLength());
	for (i = 0; i &lt; domains.getLength(); i++) {
		vars.put(&quot;RESULT_DOMAIN_NAME_&quot; + i,								getValue(domains.item(i),&quot;name&quot;));
		vars.put(&quot;RESULT_CHECK_DIGIT_CLASS_&quot; + i,							getValue(domains.item(i),&quot;checkDigitClass&quot;));
		vars.put(&quot;RESULT_ALPHABET_&quot; + i,									getValue(domains.item(i),&quot;alphabet&quot;));
		vars.put(&quot;RESULT_COMMENT_&quot; + i,									getValue(domains.item(i),&quot;comment&quot;));
		vars.put(&quot;RESULT_NUMBER_OF_PSNS_&quot; + i,								getValue(domains.item(i),&quot;numberOfPseudonyms&quot;));
		vars.put(&quot;RESULT_CACHE_USED_&quot; + i,									getValue(domains.item(i),&quot;cacheUsed&quot;));
		vars.put(&quot;RESULT_PERCENT_PSNS_USED_&quot; + i,							getValue(domains.item(i),&quot;percentPsnsUsed&quot;));
		vars.put(&quot;RESULT_CONFIG_FORCE_CACHE_&quot; + i,							getValue(domains.item(i),&quot;forceCache&quot;));
		vars.put(&quot;RESULT_CONFIG_INCLUDE_PREFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i,	getValue(domains.item(i),&quot;includePrefixInCheckDigitCalculation&quot;));
		vars.put(&quot;RESULT_CONFIG_INCLUDE_SUFFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i,	getValue(domains.item(i),&quot;includeSuffixInCheckDigitCalculation&quot;));
		vars.put(&quot;RESULT_CONFIG_MAX_DETECTED_ERRORS_&quot; + i,					getValue(domains.item(i),&quot;maxDetectedErrors&quot;));
		vars.put(&quot;RESULT_CONFIG_PSN_LENGTH_&quot; + i,							getValue(domains.item(i),&quot;psnLength&quot;));
		vars.put(&quot;RESULT_CONFIG_PSN_PREFIX_&quot; + i,							getValue(domains.item(i),&quot;psnPrefix&quot;));
		vars.put(&quot;RESULT_CONFIG_PSN_SUFFIX_&quot; + i,							getValue(domains.item(i),&quot;psnSuffix&quot;));
		vars.put(&quot;RESULT_CONFIG_PSNS_DELETABLE_&quot; + i,						getValue(domains.item(i),&quot;psnsDeletable&quot;));
		vars.put(&quot;RESULT_CONFIG_USE_LAST_CHAR_AS_DELIMITER_AFTER_X_CHARS_&quot; + i,	getValue(domains.item(i),&quot;useLastCharAsDelimiterAfterXChars&quot;));
	}
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot read domains because: &quot; + e.printStackTrace();
}

if (Failure) {
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
