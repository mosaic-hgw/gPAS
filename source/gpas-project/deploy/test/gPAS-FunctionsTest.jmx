              <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="&gt;&gt; test RESULT (getOrCreatePseudonymsFor)">
                <stringProp name="BeanShellSampler.query">vars.put(&quot;TEST_PSN_1&quot;, vars.get(&quot;RESULT_PSN&quot;));</stringProp>
              </BeanShellSampler>
              <hashTree>
                <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="test RESULT">
                  <stringProp name="BeanShellAssertion.query">boolean havePsn = false;
boolean equalPrefix = false;
boolean equalSuffix = false;
boolean equalLength = false;

boolean isSet(String value) { return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
boolean equalsPrefix(String psn) {	return vars.get(psn).startsWith(vars.get(&quot;PREFIX&quot;)); }
boolean equalsSuffix(String psn) {	return vars.get(psn).endsWith(vars.get(&quot;SUFFIX&quot;)); }
boolean equalsLength(String psn) { return vars.get(psn).replace(vars.get(&quot;PREFIX&quot;),&quot;&quot;).replace(vars.get(&quot;SUFFIX&quot;),&quot;&quot;).length() == ${__intSum(${PSN_LENGTH},${CHECK_DIGIT_LENGTH})}; }

if (isSet(&quot;RESULT_PSN_0&quot;) &amp;&amp; isSet(&quot;RESULT_PSN_1&quot;)) {
	havePsn = true;
	if (equalsPrefix(&quot;RESULT_PSN_0&quot;) &amp;&amp; equalsPrefix(&quot;RESULT_PSN_1&quot;)) { equalPrefix = true; }
	if (equalsSuffix(&quot;RESULT_PSN_0&quot;) &amp;&amp; equalsSuffix(&quot;RESULT_PSN_1&quot;)) { equalSuffix = true; }
	if (equalsLength(&quot;RESULT_PSN_0&quot;) &amp;&amp; equalsLength(&quot;RESULT_PSN_1&quot;)) { equalLength = true; }
}

if (havePsn == false) {
	Failure = true ;
	FailureMessage = &quot;psn not found&quot;;
} else if (equalPrefix == false) {
	Failure = true ;
	FailureMessage = &quot;psn-prefix ${PREFIX} not in ${RESULT_PSN_0} and ${RESULT_PSN_1}&quot;;
} else if (equalSuffix == false) {
	Failure = true ;
	FailureMessage = &quot;psn-suffix ${SUFFIX} not in ${RESULT_PSN_0} and ${RESULT_PSN_1}&quot;;
} else if (equalLength == false) {
	Failure = true ;
	FailureMessage = &quot;psn-length + check-digit + ${PSN_LENGTH} + ${CHECK_DIGIT_LENGTH} not correct for ${RESULT_PSN_0} or ${RESULT_PSN_1} with length &quot;;
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
                  <stringProp name="BeanShellAssertion.filename"></stringProp>
                  <stringProp name="BeanShellAssertion.parameters"></stringProp>
                  <boolProp name="BeanShellAssertion.resetInterpreter">false</boolProp>
                </BeanShellAssertion>
