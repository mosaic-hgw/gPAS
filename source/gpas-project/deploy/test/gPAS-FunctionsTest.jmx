                  <stringProp name="BeanShellAssertion.query">boolean isEqual(String v1, String v2) {return new String(vars.get(v1)).equals(vars.get(v2));}
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}

entryFound = 0;
expectedFound = Integer.parseInt(vars.get(&quot;TEST_COUNT&quot;))-2;
anonymizedFound = 0;

for (i = 0; isSet(&quot;RESULT_VALUE_&quot; + i); i++) {
	if (vars.get(&quot;RESULT_VALUE_&quot; + i).startsWith(&quot;###_anonym_###&quot;) == true) anonymizedFound++;
	else for (j = 0; isSet(&quot;TEST_UUID_VALUE_&quot; + j); j++) {
		if (isEqual(&quot;RESULT_VALUE_&quot; + i, &quot;TEST_UUID_VALUE_&quot; + j) &amp;&amp; isEqual(&quot;RESULT_PSN_&quot; + i, &quot;TEST_UUID_PSN_&quot; + j)) entryFound++;
	}
}

if (expectedFound != anonymizedFound) {
	Failure = true ;
	FailureMessage = &quot; anonymized psns found &quot; + anonymizedFound + &quot;, expected &quot; + expectedFound + &quot;, psns found &quot; + entryFound;
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
