                <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="test PSN" enabled="true">
                  <stringProp name="BeanShellAssertion.query">boolean isEqual(String v1, String v2) {return new String(vars.get(v1)).equals(vars.get(v2));}
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}

entryFound = 0;
expectedFound = Integer.parseInt(vars.get(&quot;TEST_COUNT&quot;));

for (i = 0; isSet(&quot;RESULT_VALUE_&quot; + i); i++) {
	for (j = 0; isSet(&quot;TEST_UUID_VALUE_&quot; + j); j++) {
		if (isEqual(&quot;RESULT_VALUE_&quot; + i, &quot;TEST_UUID_VALUE_&quot; + j) &amp;&amp; isEqual(&quot;RESULT_PSN_&quot; + i, &quot;TEST_UUID_PSN_&quot; + j)) {
			entryFound++;
			continue;
		}
	}
	if (isEqual(&quot;RESULT_VALUE_&quot; + i, &quot;TEST_VALUE_1&quot;) &amp;&amp; isEqual(&quot;RESULT_PSN_&quot; + i, &quot;TEST_PSN_1&quot;)) entryFound++;
	if (isEqual(&quot;RESULT_VALUE_&quot; + i, &quot;TEST_VALUE_2&quot;) &amp;&amp; isEqual(&quot;RESULT_PSN_&quot; + i, &quot;TEST_PSN_2&quot;)) entryFound++;
}

if (expectedFound != entryFound) {
	Failure = true ;
	FailureMessage = &quot;psns not found &quot; + entryFound + &quot;/&quot; + expectedFound;
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
