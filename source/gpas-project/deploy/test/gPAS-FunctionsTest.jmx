	if (isSet(&quot;RESULT_CONFIG_INCLUDE_SUFFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i))	vars.remove(&quot;RESULT_CONFIG_INCLUDE_SUFFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i);
