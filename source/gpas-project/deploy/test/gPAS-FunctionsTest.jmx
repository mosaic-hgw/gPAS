                    <boolProp name="resetInterpreter">false</boolProp>
                    <stringProp name="script">String requestBody = sampler.getArguments().getArgument(0).getValue();
vars.put(&quot;DATA_REQUEST_BODY&quot;, requestBody);

if (vars.get(&quot;DEBUG_LOGGING&quot;).equalsIgnoreCase(&quot;true&quot;)) {
	String out = &quot;\nREQUEST &gt;&gt;&gt;\n&quot;+requestBody+&quot;\n&quot;;	
