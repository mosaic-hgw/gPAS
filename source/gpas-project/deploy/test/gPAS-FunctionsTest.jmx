                <hashTree/>
                <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="test PSN + UUID_PSN" enabled="true">
                  <stringProp name="BeanShellAssertion.query">boolean isEqual(String v1, String v2) {return new String(vars.get(v1)).equals(vars.get(v2));}
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
expectedFound = 2;
i = 0;
maxTestPSNs = Integer.parseInt(vars.get(&quot;MAX_PSNS&quot;)) + 2;

for (j=0; isSet(&quot;RESULT_VALUE_&quot; + i); i++) {
	if (isEqual(&quot;RESULT_VALUE_&quot; + i, &quot;TEST_VALUE_1&quot;)) {
		expectedFound--;
		vars.put(&quot;TEST_PSN_1&quot;, vars.get(&quot;RESULT_PSN_&quot; + i));
	}
	else if (isEqual(&quot;RESULT_VALUE_&quot; + i, &quot;TEST_VALUE_2&quot;)) {
		expectedFound--;
		vars.put(&quot;TEST_PSN_2&quot;, vars.get(&quot;RESULT_PSN_&quot; + i));
	}
	else if (j &lt; maxTestPSNs) {
		vars.put(&quot;TEST_UUID_VALUE_&quot; + j, vars.get(&quot;RESULT_VALUE_&quot; + i));
		vars.put(&quot;TEST_UUID_PSN_&quot; + j, vars.get(&quot;RESULT_PSN_&quot; + i));
		j++;
	}
}

if (expectedFound != 0) {
	Failure = true ;
	FailureMessage = &quot;psns not found &quot; + expectedFound + &quot;/&quot; + i;
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
