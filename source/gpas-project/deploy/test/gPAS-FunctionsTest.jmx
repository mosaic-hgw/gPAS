                  <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="get RESULT" enabled="true">
                    <stringProp name="BeanShellAssertion.query">import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathFactory;
import org.w3c.dom.Document;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
}

if (Failure != true) try {
	String expression = &quot;/Envelope/Body/getDomainsForSuffixResponse/domainList&quot;;
	NodeList domains = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
	vars.put(&quot;RESULT_COUNT&quot;,	&quot;&quot;+domains.getLength());
	for (i = 0; i &lt; domains.getLength(); i++) {
		vars.put(&quot;RESULT_DOMAIN_NAME_&quot; + i,		domains.item(i).getElementsByTagName(&quot;name&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CHECK_DIGIT_CLASS_&quot; + i,	domains.item(i).getElementsByTagName(&quot;checkDigitClass&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_ALPHABET_&quot; + i,			domains.item(i).getElementsByTagName(&quot;alphabet&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_COMMENT_&quot; + i,			domains.item(i).getElementsByTagName(&quot;comment&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_NUMBER_OF_PSNS_&quot; + i,		domains.item(i).getElementsByTagName(&quot;numberOfPseudonyms&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CACHE_USED_&quot; + i,			domains.item(i).getElementsByTagName(&quot;cacheUsed&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_PERCENT_PSNS_USED_&quot; + i,	domains.item(i).getElementsByTagName(&quot;percentPsnsUsed&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_FORCE_CACHE_&quot; + i,							domains.item(i).getElementsByTagName(&quot;forceCache&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_INCLUDE_PREFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i,	domains.item(i).getElementsByTagName(&quot;includePrefixInCheckDigitCalculation&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_INCLUDE_SUFFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i,	domains.item(i).getElementsByTagName(&quot;includeSuffixInCheckDigitCalculation&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_MAX_DETECTED_ERRORS_&quot; + i,					domains.item(i).getElementsByTagName(&quot;maxDetectedErrors&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSN_LENGTH_&quot; + i,							domains.item(i).getElementsByTagName(&quot;psnLength&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSN_PREFIX_&quot; + i,							domains.item(i).getElementsByTagName(&quot;psnPrefix&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSN_SUFFIX_&quot; + i,							domains.item(i).getElementsByTagName(&quot;psnSuffix&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_PSNS_DELETABLE_&quot; + i,						domains.item(i).getElementsByTagName(&quot;psnsDeletable&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_CONFIG_USE_LAST_CHAR_AS_DELIMITER_AFTER_X_CHARS_&quot; + i,	domains.item(i).getElementsByTagName(&quot;useLastCharAsDelimiterAfterXChars&quot;).item(0).getTextContent());
	}
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot read domains because: &quot; + e.printStackTrace();
}

if (Failure) {
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
