                <stringProp name="BeanShellSampler.query">String out = Label.replace(&quot;&gt;&gt; set parameter (&quot;, &quot;jmeter --------- &quot;).replace(&quot;)&quot;, &quot; ---------&quot;);
log.info(out);
System.out.println(out);

// requierd
vars.put(&quot;PARAM_DOMAIN&quot;,		&quot;${DOMAIN}&quot;);
// test
vars.put(&quot;TEST_STATUS_CODE&quot;,	&quot;200&quot;);
vars.put(&quot;TEST_CONTAINS&quot;,	&quot;&quot;);
vars.put(&quot;TEST_COUNT&quot;,		vars.get(&quot;MAX_PSNS&quot;));
// logging
vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;,	&quot;false&quot;);</stringProp>
