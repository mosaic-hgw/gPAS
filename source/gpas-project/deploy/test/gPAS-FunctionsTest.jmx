                  <stringProp name="BeanShellSampler.query">String out = Label.replace(&quot;&gt;&gt; set parameter (&quot;, &quot;jmeter --------- &quot;).replace(&quot;)&quot;, &quot; ---------&quot;);
log.info(out);
System.out.println(out);

// clear params
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
for (i = 0; isSet(&quot;PARAM_VALUE_&quot; + i); i++) vars.remove(&quot;PARAM_VALUE_&quot; + i);

vars.put(&quot;PARAM_DOMAIN&quot;, &quot;&quot;);

// max value-size ~64k bytes (entspricht ~1.200x UUIDs(36 bytes) + Tags(17 bytes))
Integer total = 49999;
Integer parts = 0;
StringJoiner VALUES = null;

do {
  VALUES = new StringJoiner(&quot;&lt;/values&gt;&lt;values&gt;&quot;);
  for (i=0; i&lt;1200 &amp;&amp; total&gt;0; i++,total--) VALUES.add(UUID.randomUUID().toString());
  vars.put(&quot;PARAM_VALUE_&quot;+(parts++), VALUES.toString());
} while (total&gt;0);

// test
vars.put(&quot;TEST_STATUS_CODE&quot;,	&quot;200&quot;);
vars.put(&quot;TEST_CONTAINS&quot;,	&quot;&quot;);
vars.put(&quot;TEST_COUNT&quot;,		&quot;1&quot;);
// logging
vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;,	&quot;false&quot;);</stringProp>
