		vars.put(&quot;RESULT_DOMAIN_&quot; + i, entries.item(i).getElementsByTagName(&quot;domainName&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_VALUE_&quot; + i, entries.item(i).getElementsByTagName(&quot;originalValue&quot;).item(0).getTextContent());
		vars.put(&quot;RESULT_PSN_&quot; + i, entries.item(i).getElementsByTagName(&quot;pseudonym&quot;).item(0).getTextContent());
	}
} catch (Exception e) {  
