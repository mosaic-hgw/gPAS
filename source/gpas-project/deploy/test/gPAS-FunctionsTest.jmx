              <hashTree>
                <BeanShellAssertion guiclass="BeanShellAssertionGui" testclass="BeanShellAssertion" testname="test RESULT" enabled="true">
                  <stringProp name="BeanShellAssertion.query">boolean found = false;
boolean equal = false;
boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
boolean isEqual(String v1, String v2) {return new String(vars.get(v1)).equals(vars.get(v2));}
boolean isEqualLog(String v1, String v2) {if (new String(vars.get(v1)).equals(vars.get(v2))){return true;}else{log.warn(v1+&quot;: &quot;+vars.get(v1)+&quot; != &quot;+vars.get(v2));return false;}}

for (i = 0; isSet(&quot;RESULT_DOMAIN_NAME_&quot; + i); i++) {
	if (isEqual(&quot;RESULT_DOMAIN_NAME_&quot; + i, &quot;OPT_NAME&quot;)) {
		found = true;
		if (
			isEqualLog(&quot;RESULT_CHECK_DIGIT_CLASS_&quot; + i,							&quot;OPT_CHECK_DIGIT_CLASS&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_ALPHABET_&quot; + i,									&quot;OPT_ALPHABET&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_COMMENT_&quot; + i,									&quot;OPT_COMMENT&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_FORCE_CACHE_&quot; + i,							&quot;OPT_PROP_FORCE_CACHE&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_INCLUDE_PREFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i,	&quot;OPT_PROP_PREFIX_IN_CHECK&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_INCLUDE_SUFFIX_IN_CHECK_DIGIT_CALCULATION_&quot; + i,	&quot;OPT_PROP_SUFFIX_IN_CHECK&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_MAX_DETECTED_ERRORS_&quot; + i,					&quot;OPT_PROP_MAX_DETECTED_ERR&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_PSN_LENGTH_&quot; + i,							&quot;OPT_PROP_PSN_LENGTH&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_PSN_PREFIX_&quot; + i,							&quot;OPT_PROP_PREFIX&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_PSN_SUFFIX_&quot; + i,							&quot;OPT_PROP_SUFFIX&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_PSNS_DELETABLE_&quot; + i,						&quot;OPT_PROP_DELETABLE&quot;) &amp;&amp;
			isEqualLog(&quot;RESULT_CONFIG_USE_LAST_CHAR_AS_DELIMITER_AFTER_X_CHARS_&quot; + i,	&quot;OPT_PROP_LAST_X_CHAR_AS_DELIMITER&quot;)
		) {
			equal = true;
		}
		break;
	}
}

if (found == false) {
	Failure = true ;
	FailureMessage = &quot;Added domain not found&quot;;
} else if (equal == false) {
	Failure = true ;
	FailureMessage = &quot;Added domain not equal to source values&quot;;
}

if (Failure) {
	vars.put(&quot;LOG_REQUEST_AND_RESPONSE&quot;, &quot;true&quot;);
	log.error(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
	System.out.println(Label + &quot; &gt;&gt;&gt; &quot; + FailureMessage);
}</stringProp>
