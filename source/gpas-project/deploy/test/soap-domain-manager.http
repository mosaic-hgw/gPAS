### Update Domain
POST {{soap_manage_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:updateDomain>
			<domainDTO>
				<!--Optional:-->
				<name>{{domain_name}}</name>
				<!--Optional:-->
				<label>{{domain_name}}</label>
				<!--Optional:-->
				<checkDigitClass>{{domain_check}}</checkDigitClass>
				<!--Optional:-->
				<alphabet>{{domain_alphabet}}</alphabet>
				<!--Optional:-->
				<config>
					<!--Optional:-->
					<forceCache>DEFAULT</forceCache>
					<includePrefixInCheckDigitCalculation>false</includePrefixInCheckDigitCalculation>
					<includeSuffixInCheckDigitCalculation>false</includeSuffixInCheckDigitCalculation>
					<maxDetectedErrors>2</maxDetectedErrors>
					<multiPsnDomain>true</multiPsnDomain>
					<psnLength>8</psnLength>
					<!--Optional:-->
					<psnPrefix>test_</psnPrefix>
					<!--Optional:-->
					<!--psnSuffix>?</psnSuffix-->
					<psnsDeletable>true</psnsDeletable>
					<sendNotificationsWeb>false</sendNotificationsWeb>
					<useLastCharAsDelimiterAfterXChars>0</useLastCharAsDelimiterAfterXChars>
					<!--Optional:-->
					<validateValuesViaParents>OFF</validateValuesViaParents>
				</config>
				<!--Optional:-->
				<!--comment>?</comment-->
				<!--Zero or more repetitions:-->
				<!--parentDomainNames>?</parentDomainNames-->
			</domainDTO>
		</psn:updateDomain>
	</soapenv:Body>
</soapenv:Envelope>


### Update Domain in Use
POST {{soap_manage_url}}
Content-Type: application/xml

<soapenv:Envelope xmlns:soapenv="http://schemas.xmlsoap.org/soap/envelope/" xmlns:psn="http://psn.ttp.ganimed.icmvc.emau.org/">
	<soapenv:Header/>
	<soapenv:Body>
		<psn:updateDomainInUse>
			<domainName>{{domain_name}}</domainName>
			<label>{{domain_name}}</label>
			<!--comment>?</comment-->
			<!--1 or more repetitions:-->
			<!--parentDomainNames>?</parentDomainNames-->
			<sendNotificationsWeb>false</sendNotificationsWeb>
			<psnsDeletable>true</psnsDeletable>
		</psn:updateDomainInUse>
	</soapenv:Body>
</soapenv:Envelope>